# VoiceBridge 0.4.1 China mainland edition. Copy to .env.
# Required: Alibaba Cloud Model Studio API Key, Beijing region.
ASR_PROVIDER=aliyun
DASHSCOPE_API_KEY=
ASR_MODEL=paraformer-realtime-v2
ASR_LANGUAGE=zh
ASR_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# Optional: workspace ID. The key, workspace and URL must be in the same region.
DASHSCOPE_WORKSPACE_ID=
ASR_TIMEOUT_MS=30000
ASR_CONCURRENCY=4
ASR_CHUNK_SECONDS=4
VAD_THRESHOLD=0.008
# Optional DeepSeek semantic segmentation. Local rules work without this key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=10000
HOST=127.0.0.1
PORT=8787
PCM_BRIDGE_PORT=8790
MAX_CAPTURE_GB=8

# Configure DEEPSEEK_API_KEY for contextual emotion classification.
# Without it: keyword screening only; manual preview required.

VAD_MIN_SPEECH_MS=120
VAD_PRE_ROLL_MS=200
VAD_SILENCE_MS=600
VAD_POST_ROLL_MS=100

# 0.6: upload during capture; false restores chunked recognition.
ASR_STREAMING=true
ASR_STREAM_CONCURRENCY=10
# Optional Paraformer v2 hotword vocabulary ID.
ASR_VOCABULARY_ID=
